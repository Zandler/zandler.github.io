---
import { about } from '../data/resume';
import { site, withBase } from '../data/site';
import Icon from './Icon.astro';
---

<section class="section section-alt" id="about">
  <div class="container">
    <p class="eyebrow">About</p>
    <h2 class="section-heading">About</h2>
    <p class="about-quote">{about.eyebrowQuote}</p>

    <div class="about-grid">
      <div class="about-visual">
        <img src={withBase('/img/devops_culture.png')} alt="SRE/Devops" loading="lazy" />
      </div>
      <div class="about-body">
        <h3 class="about-heading">
          <span class="accent">{about.heading}</span>
        </h3>
        <p class="about-sub">{about.subheading}</p>
        {about.paragraphs.map((p) => <p class="about-paragraph">{p}</p>)}
        <a class="btn btn-primary" href={withBase(site.author.resume)} target="_blank" rel="noopener">
          <Icon name="download" /> {site.author.resumeLabel}
        </a>
      </div>
    </div>
  </div>
</section>
