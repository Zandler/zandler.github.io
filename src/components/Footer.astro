---
import { site, withBase, labelFor, type Lang } from '../data/site';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const navLinks = [
  { path: '/blog', en: 'Essays', pt: 'Ensaios' },
  { path: '/work', en: 'Work', pt: 'Experiência' },
  { path: '/sobre', en: 'About', pt: 'Sobre' },
].map((l) => ({
  href: lang === 'pt' ? withBase(`/pt${l.path}`) : withBase(l.path),
  label: labelFor(lang, { en: l.en, pt: l.pt }),
}));

const socials = Object.values(site.socials).filter((s) => !s.url.endsWith('/rss.xml'));
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-block">
        <p class="footer-name">{site.author.name}<span style="color: var(--accent-fill);">.</span></p>
        <p class="footer-note">
          Essays on design systems and systems architecture. Every word written
          and edited by hand — in English, then Brazilian Portuguese.
        </p>
      </div>

      <div class="footer-block">
        <h4>{labelFor(lang, { en: 'Index', pt: 'Índice' })}</h4>
        <ul class="footer-links">
          {navLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-block">
        <h4>{labelFor(lang, { en: 'Contact', pt: 'Contato' })}</h4>
        <ul class="footer-links">
          {socials.map((s) => (
            <li>
              <a href={withBase(s.url)} target={s.url.startsWith('http') ? '_blank' : undefined} rel="noopener">
                {s.label}
              </a>
            </li>
          ))}
          <li><a href={withBase(site.author.resume)}>{site.author.resumeLabel}</a></li>
        </ul>
      </div>

      <div class="footer-bottom">
        <span>&copy; {new Date().getFullYear()} {site.author.name} · {site.author.location}</span>
        <span>
          Written by a human.
          <a href={lang === 'pt' ? withBase('/pt/sobre') : withBase('/sobre')}>
            {labelFor(lang, { en: 'Editorial policy', pt: 'Política editorial' })}
          </a>.
        </span>
      </div>
    </div>
  </div>
</footer>