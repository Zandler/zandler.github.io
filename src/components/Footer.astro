---
import { site, withBase } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-name">{site.author.name}</p>
      <p class="footer-role">{site.author.role}</p>
    </div>
    <ul class="footer-links">
      <li><a href={withBase('/')}>Home</a></li>
      <li><a href={withBase('/#about')}>About</a></li>
      <li><a href={withBase('/#experience')}>Experience</a></li>
      <li><a href={withBase('/#skills')}>Skills</a></li>
      <li><a href={withBase('/#projects')}>Projects</a></li>
      <li><a href={withBase('/#contact')}>Contact</a></li>
    </ul>
    <ul class="footer-links">
      {Object.values(site.socials).filter((s) => !s.url.endsWith('/rss.xml')).map((s) => (
        <li>
          <a href={withBase(s.url)} target={s.url.startsWith('http') ? '_blank' : undefined} rel="noopener">{s.label}</a>
        </li>
      ))}
    </ul>
    <p>&copy; {new Date().getFullYear()} {site.author.name} &middot; {site.author.location}</p>
  </div>
</footer>
