---
import { projects } from '../data/resume';
import { withBase } from '../data/site';
---

<section class="section section-alt" id="projects">
  <div class="container">
    <p class="eyebrow">Projects</p>
    <h2 class="section-heading">All my best works</h2>

    <div class="project-grid">
      {
        projects.map((p) => (
          <article class="card project-card">
            <div class="project-thumb">
              <img src={withBase(p.image)} alt={p.imageAlt} loading="lazy" />
            </div>
            <div class="project-body">
              <h3>{p.title}</h3>
              <p class="project-desc">{p.description}</p>
              <div class="tag-list">
                {p.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
              <a class="btn btn-primary project-link" href={p.url} target="_blank" rel="noopener">
                {p.linkLabel}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
