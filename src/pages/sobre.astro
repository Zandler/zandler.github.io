---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import { site, withBase } from '../data/site';
import { experience } from '../data/resume';

const current = experience.find((e) => e.current) ?? experience[0];
const socials = Object.values(site.socials).filter((s) => !s.url.endsWith('/rss.xml'));
---

<Layout title="About" description={`About ${site.author.name} and the editorial policy of zandler.com.br.`}>
  <section class="section">
    <div class="container" style="max-width: 860px;">
      <p class="kicker">About</p>
      <h1>Zandler Oliveira<span class="num-prefix" style="font-size: 0.5em;">_</span></h1>
      <p class="muted" style="max-width: 64ch;">
        SRE, architect and writer. {current ? `${current.role} at ${current.company} — ` : ''}
        fifteen years on the infrastructure side of Brazilian banks and fintechs.
      </p>

      <div class="home-actions" style="margin-bottom: 2.5rem;">
        {socials.map((s) => (
          <a class="btn" href={withBase(s.url)} target={s.url.startsWith('http') ? '_blank' : undefined} rel="noopener">
            {s.label}
          </a>
        ))}
        <a class="btn" href={withBase(`mailto:${site.author.email}`)}>
          <Icon name="email" size={16} /> Email
        </a>
      </div>

      <div class="prose" style="max-width: 60ch;">
        <p>
          My career was built where engineering and culture meet: data centers and Kubernetes,
          ticketing and platform teams, architecture references and the people who have to follow
          them. I wrote the first essays of this site because design systems fail or succeed on the
          exact same problems infrastructure does — ownership, boundaries and change.
        </p>
        <p>
          This site is the artifact of that thesis. It runs on its own design system —
          <a href={withBase('/design-system')}>Blueprint</a> — and everything documented there is
          applied here first. That is also how I write: by building, then explaining what I built.
        </p>
        <p>
          <a href={withBase('/work')}>The work page</a> has the full history, and the
          <a href={withBase('/blog')}> essays</a> hold the arguments.
        </p>
      </div>

      <div class="policy-box">
        <p class="kicker">Editorial policy</p>
        <h2>Written by a human.</h2>
        <ul>
          <li>Every essay is written and edited by the author. No text on this site is generated by AI.</li>
          <li>AI is used only as a punctual review aid — never to produce sentences, paragraphs or diagrams.</li>
          <li>Each essay is published in English first, then translated by the author to Brazilian Portuguese. Never by machine translation.</li>
          <li>Diagrams are built from <a href={withBase('/design-system')}>Blueprint's</a> own components or hand-drawn — never generated images.</li>
          <li>What you read is the author's position, in the author's words, faults included.</li>
        </ul>
      </div>

      <p class="kicker">Currently</p>
      <div style="border-top: 1px solid var(--line-strong);">
        <div class="type-sample">
          <span class="tag">Writing</span>
          <span>Monthly essays on design systems, architecture and SRE — EN + PT.</span>
        </div>
        <div class="type-sample">
          <span class="tag">Building</span>
          <span>{site.author.role} — {site.author.location}.</span>
        </div>
        <div class="type-sample">
          <span class="tag">Elsewhere</span>
          <span>
            {socials.map((s, i) => (
              <><a href={withBase(s.url)} target={s.url.startsWith('http') ? '_blank' : undefined} rel="noopener">{s.label}</a>{i < socials.length - 1 ? ' · ' : ''}</>
            ))}
          </span>
        </div>
      </div>
    </div>
  </section>
</Layout>