---
import Layout from '../../../components/Layout.astro';
import EssayRow from '../../../components/EssayRow.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

type Props = { tag: string };

const { tag } = Astro.props;
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.tags.includes(tag))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title={`#${tag}`} description={`Essays tagged #${tag}`}>
  <section class="section">
    <div class="container">
      <p class="kicker">Tag</p>
      <h1>#{tag}</h1>
      <p class="muted">{posts.length} essay{posts.length === 1 ? '' : 's'}</p>
      <div class="essay-list" style="margin-top: 2rem;">
        {posts.map((post, i) => <EssayRow post={post} index={i + 1} />)}
      </div>
    </div>
  </section>
</Layout>