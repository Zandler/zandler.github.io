---
import Layout from '../../components/Layout.astro';
import EssayRow from '../../components/EssayRow.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../data/content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byCategory = (id: string) => posts.filter((p) => p.data.category === id);
const count = (id: string) => byCategory(id).length;
---

<Layout title="Essays" description="Essays on design systems, systems architecture and engineering — written by hand.">
  <section class="section">
    <div class="container">
      <p class="kicker">Essays</p>
      <h1>Long-form, written by hand.</h1>
      <p class="muted" style="max-width: 58ch;">
        One essay per topic per month, in English first and Brazilian Portuguese after. No generated
        text anywhere — <a href="/sobre/">see the editorial policy</a>.
      </p>

      <ul class="cat-tabs">
        {categories.map((c) => (
          <li><a href={`#${c.id}`} aria-current={undefined}>{c.index} · {c.label} ({count(c.id)})</a></li>
        ))}
      </ul>

      <div class="essay-list">
        {categories.map((c) => (
          <div style="margin-bottom: 3rem;">
            <h2 id={c.id} style="scroll-margin-top: calc(var(--nav-h) + 16px); font-size: 1.4rem;">
              <span class="num-prefix">{c.index}</span> {c.label}
            </h2>
            <p class="muted" style="margin: 0.15rem 0 1.5rem; font-size: 0.95rem;">{c.blurb}</p>
            {byCategory(c.id).map((post, i) => <EssayRow post={post} index={i + 1} />)}
            {byCategory(c.id).length === 0 && (
              <p class="muted">Nothing published yet — the first essays are being written.</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>